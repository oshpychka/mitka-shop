{
	"core": "https://wordpress.org/wordpress-7.1.3.zip",
	"phpVersion": "8.3",
	"plugins": [
		"https://downloads.wordpress.org/plugin/woocommerce.11.2.1.zip",
		"https://downloads.wordpress.org/plugin/advanced-custom-fields.6.8.10.zip",
		"https://downloads.wordpress.org/plugin/polylang.3.9.zip"
	],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_DISPLAY": false,
		"WP_DEBUG_LOG": true,
		"DISALLOW_FILE_EDIT": true,
		"WP_POST_REVISIONS": 5
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp theme activate mitka"
	},
	"mappings": {
		"wp-content/themes/mitka": "."
	},
	"testsEnvironment": false
}
